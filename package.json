{
  "name": "dotmatrix",
  "private": true,
  "description": "Game Boy chiptune apps for the web, built with Lumiose.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:pocket": "pnpm --filter @dotmatrix/pocket dev",
    "dev:react": "pnpm --filter @dotmatrix/pocket-react dev",
    "dev:advanced": "pnpm --filter @dotmatrix/advanced dev",
    "build": "pnpm -r build",
    "build:site": "node scripts/site.ts build",
    "preview:site": "node scripts/site.ts preview",
    "test": "pnpm -r test && node --test scripts/site.test.ts",
    "test:e2e": "pnpm -r --workspace-concurrency=1 test:e2e && pnpm test:site",
    "test:site": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "pnpm -r lint && oxlint scripts tests playwright.config.ts",
    "fmt": "oxfmt . && pnpm -r fmt",
    "fmt:check": "oxfmt --check . && pnpm -r fmt:check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}

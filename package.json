{
  "name": "dotmatrix",
  "private": true,
  "description": "Game Boy chiptune apps for the web, built with Lumiose.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:pocket": "pnpm --filter @dotmatrix/pocket dev",
    "dev:advanced": "pnpm --filter @dotmatrix/advanced dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r --workspace-concurrency=1 test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "fmt": "oxfmt . && pnpm -r fmt",
    "fmt:check": "oxfmt --check . && pnpm -r fmt:check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}

{
  "name": "@dotmatrix/pocket-react",
  "version": "0.0.0",
  "private": true,
  "description": "Dotmatrix Pocket ported to React: the same Game Boy chiptune studio and SFX maker on the gbaudio engine, as a client-rendered SPA with React 19, the React Compiler, React Router and Vite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p .",
    "lint": "oxlint -c .oxlintrc.json .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "clsx": "^2.1.1",
    "gbaudio": "^1.0.1",
    "immer": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
